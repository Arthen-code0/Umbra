---
/**
 * Cielo estrellado en SVG puro: es el hero completo para quien tiene
 * movimiento reducido, JavaScript desactivado o un dispositivo poco potente,
 * y el fondo sobre el que aparece la escena 3D en el resto de casos.
 */
const estrellas = Array.from({ length: 70 }, (_, i) => {
  const a = (i * 9301 + 49297) % 233280;
  const b = (a * 9301 + 49297) % 233280;
  const c = (b * 9301 + 49297) % 233280;
  return {
    x: (a / 233280) * 1000,
    y: (b / 233280) * 520,
    r: 0.6 + (c / 233280) * 1.4,
    o: 0.35 + (c / 233280) * 0.65,
  };
});
const constelacion = [
  [610, 150],
  [680, 190],
  [730, 130],
  [800, 210],
  [860, 170],
  [760, 290],
  [690, 330],
] as const;
const enlaces = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [3, 5],
  [5, 6],
  [1, 6],
] as const;
---

<div class="hero-estatico" aria-hidden="true">
  <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="hero-cielo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#070a13"></stop>
        <stop offset="65%" stop-color="#101830"></stop>
        <stop offset="100%" stop-color="#2a2540"></stop>
      </linearGradient>
    </defs>
    <rect width="1000" height="600" fill="url(#hero-cielo)"></rect>
    {estrellas.map((e) => (
      <circle cx={e.x} cy={e.y} r={e.r} fill="#f1eee6" opacity={e.o}></circle>
    ))}
    <g class="hero-estatico__constelacion" stroke="#f0b374" stroke-width="1.2" opacity="0.7">
      {enlaces.map(([a, b]) => (
        <line
          x1={constelacion[a][0]}
          y1={constelacion[a][1]}
          x2={constelacion[b][0]}
          y2={constelacion[b][1]}
        />
      ))}
    </g>
    <g class="hero-estatico__constelacion" fill="#f0b374">
      {constelacion.map(([x, y]) => (
        <circle cx={x} cy={y} r="3.6"></circle>
      ))}
    </g>
    <path
      d="M0 600V470l90-60 70 40 110-95 90 70 100-80 120 90 90-55 130 85 80-40 110 70v90z"
      fill="#05070d"
    ></path>
  </svg>
</div>
