---
import LayoutBase from '../layouts/LayoutBase.astro';
import { SITIO } from '../lib/sitio';
---

<LayoutBase titulo="Inicio" descripcion={SITIO.descripcion} ruta="/">
  <section class="franja contenedor">
    <h1>{SITIO.eslogan}</h1>
    <p class="lectura">
      Esta página se completa en las tareas T-13 y T-14 (hero 3D y scroll narrativo). Por ahora
      demuestra que el sistema de diseño, el layout y el selector de tema funcionan.
    </p>
    <a class="boton boton--primario" href="/experiencias">
      Ver experiencias
    </a>
  </section>
</LayoutBase>
