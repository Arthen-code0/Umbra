---
import LayoutBase from '../layouts/LayoutBase.astro';

const descripcion = 'Esta página no existe. Vuelve al inicio o explora las experiencias de Umbra.';
---

<LayoutBase titulo="Página no encontrada" descripcion={descripcion} ruta="/404">
  <section class="franja contenedor pagina-404">
    <svg
      class="pagina-404__ilustracion"
      viewBox="0 0 320 200"
      role="img"
      aria-label="Un telescopio apuntando a una zona del cielo sin estrellas"
    >
      <g fill="var(--color-texto-suave)">
        <circle cx="30" cy="30" r="1.6"></circle>
        <circle cx="80" cy="70" r="1.2"></circle>
        <circle cx="250" cy="25" r="1.8"></circle>
        <circle cx="290" cy="90" r="1.3"></circle>
        <circle cx="200" cy="60" r="1.1"></circle>
      </g>
      <circle
        cx="180"
        cy="40"
        r="26"
        fill="none"
        stroke="var(--color-borde-interactivo)"
        stroke-width="1.5"
        stroke-dasharray="4 5"
      ></circle>
      <path
        d="M100 170l55-95"
        stroke="var(--color-primario)"
        stroke-width="10"
        stroke-linecap="round"
      ></path>
      <path
        d="M96 175l-22 20M104 175l22 20M100 170v25"
        stroke="var(--color-texto-suave)"
        stroke-width="3"
        stroke-linecap="round"
      ></path>
      <path d="M0 195h320" stroke="var(--color-borde)" stroke-width="2"></path>
    </svg>
    <p class="ojo-de-texto">Error 404</p>
    <h1>Aquí no hay ni una estrella</h1>
    <p class="lectura">
      El telescopio apunta a estas coordenadas y solo ve oscuridad (de la buena, pero sin página).
      Puede que el enlace esté mal escrito o que la página haya cambiado de sitio.
    </p>
    <div class="pagina-404__acciones">
      <a class="boton boton--primario" href="/">
        Volver al inicio
      </a>
      <a class="boton boton--secundario" href="/experiencias">
        Ver experiencias
      </a>
    </div>
  </section>
</LayoutBase>
